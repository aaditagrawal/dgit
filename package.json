{
  "name": "dgit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write \"**/*.{js,mjs,cjs,ts,tsx,jsx}\" --ignore-path .gitignore --no-error-on-unmatched-pattern",
    "format:check": "oxfmt --check \"**/*.{js,mjs,cjs,ts,tsx,jsx}\" --ignore-path .gitignore --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@isomorphic-git/lightning-fs": "^4.7.0",
    "@stylexjs/stylex": "0.19.0",
    "@tanstack/react-devtools": "^0.10.9",
    "@tanstack/react-router": "^1.170.23",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.40",
    "@tanstack/router-plugin": "^1.168.27",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "isomorphic-git": "^1.41.0",
    "lucide-react": "^1.30.0",
    "nitro": "^3.0.260610-beta",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@oxlint/plugins": "^1.78.0",
    "@stylexjs/babel-plugin": "0.19.0",
    "@stylexjs/postcss-plugin": "0.19.0",
    "@tanstack/devtools-vite": "^0.8.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.78.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "packageManager": "bun@1.4.2"
